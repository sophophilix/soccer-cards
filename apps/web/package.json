{
	"name": "@soccer-cards/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true CLOUDFLARE_CF_FETCH_ENABLED=false wrangler dev",
		"format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource/bowlby-one": "^5.3.0",
		"@fontsource/saira-condensed": "^5.3.0",
		"@soccer-cards/game": "workspace:*",
		"@sveltejs/kit": "^3.1.1",
		"svelte": "^5.57.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"vite": "^8.3.7"
	}
}
