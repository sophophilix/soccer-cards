{
	"name": "@soccer-cards/schema",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schemas/*": "./schemas/*"
	},
	"scripts": {
		"format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --coverage",
		"generate": "node --eval \"import('./src/generate-types.ts').then((m) => m.writeGeneratedTypes('schemas/v1', 'src/generated'))\""
	},
	"devDependencies": {
		"ajv": "^8.20.0",
		"json-schema-to-typescript": "^16.0.0"
	}
}
