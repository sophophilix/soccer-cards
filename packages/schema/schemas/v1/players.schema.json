{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "players.schema.json",
	"title": "PlayerList",
	"description": "Every player in the set, as served at players.json.",
	"type": "object",
	"properties": {
		"players": {
			"description": "A summary of each player.",
			"type": "array",
			"items": { "$ref": "player.schema.json#/$defs/playerSummary" }
		}
	},
	"required": ["players"]
}
