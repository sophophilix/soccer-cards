{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "player.schema.json",
	"title": "Player",
	"description": "One player in full, as served at players/{player}.json.",
	"allOf": [{ "$ref": "#/$defs/playerSummary" }],
	"type": "object",
	"properties": {
		"updateTime": {
			"description": "When this player's content last changed, as an RFC 3339 moment in UTC.",
			"type": "string",
			"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?Z$"
		},
		"clubGoalCount": {
			"description": "The player's goals for clubs.",
			"allOf": [{ "$ref": "#/$defs/goalCount" }]
		},
		"nationalTeamGoalCount": {
			"description": "The player's goals for the national team.",
			"allOf": [{ "$ref": "#/$defs/goalCount" }]
		},
		"transferFee": {
			"description": "The highest fee a club paid for the player.",
			"$ref": "#/$defs/transferFee"
		},
		"awards": {
			"description": "The awards the player won.",
			"type": "array",
			"items": { "$ref": "#/$defs/award" }
		},
		"careerStartYear": { "description": "The year of the first senior match.", "type": "integer" },
		"careerEndYear": { "description": "The year of the last senior match.", "type": "integer" }
	},
	"required": ["updateTime"],
	"$defs": {
		"playerSummary": {
			"title": "PlayerSummary",
			"$comment": "One player as the list at players.json holds it.",
			"type": "object",
			"properties": {
				"name": {
					"description": "The resource name, players/{player}. The slug is stable and never reused.",
					"type": "string",
					"pattern": "^players/[a-z][a-z0-9-]{0,62}$"
				},
				"displayName": {
					"description": "The player's name as the card shows it.",
					"type": "string",
					"minLength": 1
				},
				"givenName": {
					"description": "The player's given name. Absent unless the player has a given and a family name.",
					"type": "string",
					"minLength": 1
				},
				"familyName": {
					"description": "The player's family name. Absent unless the player has a given and a family name.",
					"type": "string",
					"minLength": 1
				},
				"state": {
					"title": "State",
					"description": "Whether the player still plays. Treat a value you don't know as unknown.",
					"enum": ["ACTIVE", "RETIRED"]
				},
				"club": {
					"description": "The resource name of the player's club, clubs/{club}. Absent for a retired player.",
					"type": "string",
					"pattern": "^clubs/[a-z][a-z0-9-]{0,62}$"
				},
				"nationalTeamCode": {
					"description": "The FIFA three-letter code of the player's national team, such as ARG.",
					"type": "string",
					"pattern": "^[A-Z]{3}$"
				},
				"position": {
					"title": "Position",
					"description": "Where the player plays. Treat a value you don't know as unknown.",
					"enum": ["GOALKEEPER", "DEFENDER", "MIDFIELDER", "FORWARD"]
				},
				"tier": {
					"title": "Tier",
					"description": "How rare the card is. Treat a value you don't know as unknown.",
					"enum": ["BASE", "RARE", "LEGEND"]
				},
				"cardNumber": {
					"description": "The number printed on the card. Absent when the card has none.",
					"type": "integer",
					"minimum": 1
				},
				"outfieldRatings": {
					"description": "The six ratings of a player who is not a goalkeeper. Absent for a goalkeeper.",
					"$ref": "#/$defs/outfieldRatings"
				},
				"goalkeeperRatings": {
					"description": "The six ratings of a goalkeeper. Absent for every other position.",
					"$ref": "#/$defs/goalkeeperRatings"
				},
				"playStats": {
					"description": "The three numbers a battle uses.",
					"$ref": "#/$defs/playStats"
				},
				"photo": { "description": "Absent when no photo is licensed.", "$ref": "#/$defs/photo" }
			},
			"required": [
				"name",
				"displayName",
				"state",
				"nationalTeamCode",
				"position",
				"tier",
				"playStats"
			],
			"dependentRequired": { "givenName": ["familyName"], "familyName": ["givenName"] },
			"if": { "properties": { "position": { "const": "GOALKEEPER" } } },
			"then": { "required": ["goalkeeperRatings"], "not": { "required": ["outfieldRatings"] } },
			"else": { "required": ["outfieldRatings"], "not": { "required": ["goalkeeperRatings"] } }
		},
		"rating": { "$comment": "A whole number.", "type": "integer", "minimum": 1, "maximum": 99 },
		"outfieldRatings": {
			"title": "OutfieldRatings",
			"type": "object",
			"properties": {
				"pace": { "description": "Running fast.", "$ref": "#/$defs/rating" },
				"shooting": { "description": "Scoring with a shot.", "$ref": "#/$defs/rating" },
				"passing": {
					"description": "Finding a team-mate with the ball.",
					"$ref": "#/$defs/rating"
				},
				"dribbling": { "description": "Running with the ball.", "$ref": "#/$defs/rating" },
				"defending": { "description": "Winning the ball back.", "$ref": "#/$defs/rating" },
				"physical": {
					"description": "Strength, stamina and jumping.",
					"$ref": "#/$defs/rating"
				}
			},
			"required": ["pace", "shooting", "passing", "dribbling", "defending", "physical"]
		},
		"goalkeeperRatings": {
			"title": "GoalkeeperRatings",
			"type": "object",
			"properties": {
				"diving": { "description": "Reaching a shot with a dive.", "$ref": "#/$defs/rating" },
				"handling": { "description": "Catching and holding the ball.", "$ref": "#/$defs/rating" },
				"kicking": { "description": "Kicking the ball far and true.", "$ref": "#/$defs/rating" },
				"reflexes": { "description": "Reacting to a close shot.", "$ref": "#/$defs/rating" },
				"speed": { "description": "Running off the goal line.", "$ref": "#/$defs/rating" },
				"positioning": {
					"description": "Standing in the right place for a shot.",
					"$ref": "#/$defs/rating"
				}
			},
			"required": ["diving", "handling", "kicking", "reflexes", "speed", "positioning"]
		},
		"playStats": {
			"title": "PlayStats",
			"type": "object",
			"properties": {
				"attack": {
					"description": "How well the card scores in a battle.",
					"$ref": "#/$defs/rating"
				},
				"defence": {
					"description": "How well the card stops a goal in a battle.",
					"$ref": "#/$defs/rating"
				},
				"control": {
					"description": "How well the card keeps the ball in a battle.",
					"$ref": "#/$defs/rating"
				}
			},
			"required": ["attack", "defence", "control"]
		},
		"httpsUri": { "type": "string", "pattern": "^https://[^\\s/?#]+[^\\s]*$" },
		"sourced": {
			"title": "Sourced",
			"type": "object",
			"properties": {
				"sourceUri": { "description": "Where the fact was read.", "$ref": "#/$defs/httpsUri" },
				"retrieveDate": {
					"description": "The day the fact was read, as YYYY-MM-DD. The pattern passes a day that doesn't exist, such as 2026-02-30. The pipeline's validate stage checks for a real date.",
					"type": "string",
					"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
				}
			},
			"required": ["sourceUri", "retrieveDate"]
		},
		"goalCount": {
			"title": "GoalCount",
			"allOf": [{ "$ref": "#/$defs/sourced" }],
			"properties": {
				"value": { "description": "The number of goals.", "type": "integer", "minimum": 0 }
			},
			"required": ["value"]
		},
		"transferFee": {
			"title": "TransferFee",
			"allOf": [{ "$ref": "#/$defs/sourced" }],
			"properties": {
				"currencyCode": {
					"description": "The ISO 4217 code.",
					"type": "string",
					"pattern": "^[A-Z]{3}$"
				},
				"units": { "description": "Whole units.", "type": "integer", "minimum": 0 },
				"nanos": {
					"description": "Billionths of a unit.",
					"type": "integer",
					"minimum": 0,
					"maximum": 999999999
				}
			},
			"required": ["currencyCode", "units", "nanos"]
		},
		"award": {
			"title": "Award",
			"allOf": [{ "$ref": "#/$defs/sourced" }],
			"properties": {
				"displayName": { "description": "The award's name.", "type": "string", "minLength": 1 }
			},
			"required": ["displayName"]
		},
		"photo": {
			"title": "Photo",
			"type": "object",
			"properties": {
				"uri": {
					"description": "The photo file, as a path inside the API with no host.",
					"type": "string",
					"pattern": "^photos/[A-Za-z0-9_-]+\\.webp$"
				},
				"widthPx": { "description": "The width in pixels.", "type": "integer", "minimum": 1 },
				"heightPx": { "description": "The height in pixels.", "type": "integer", "minimum": 1 },
				"mimeType": { "description": "The media type.", "const": "image/webp" },
				"attribution": { "description": "The credit and licence.", "$ref": "#/$defs/attribution" }
			},
			"required": ["uri", "widthPx", "heightPx", "mimeType", "attribution"]
		},
		"attribution": {
			"title": "Attribution",
			"type": "object",
			"properties": {
				"author": { "description": "The photo's author.", "type": "string", "minLength": 1 },
				"licenseCode": {
					"description": "The licence's SPDX id. Only CC0-1.0, CC-PDM-1.0 for the public domain, and the CC-BY and CC-BY-SA versions on the SPDX list are allowed.",
					"type": "string",
					"pattern": "^(CC0-1\\.0|CC-PDM-1\\.0|CC-BY-(1\\.0|2\\.0|2\\.5(-AU)?|3\\.0(-(AT|AU|DE|IGO|NL|US))?|4\\.0)|CC-BY-SA-(1\\.0|2\\.0(-UK)?|2\\.1-JP|2\\.5|3\\.0(-(AT|DE|IGO))?|4\\.0))$"
				},
				"sourceUri": { "description": "Where the photo came from.", "$ref": "#/$defs/httpsUri" }
			},
			"required": ["author", "licenseCode", "sourceUri"]
		}
	}
}
